---
/* 怡园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="怡园手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">怡园</text>
  <text x="200" y="44" class="gm-sub">集众园之长 · 晚清风雅 —— 手绘示意，非实测</text>
  <!-- 南部入口 -->
  <path class="gm-path" d="M230,368 L230,336"/>
  <text x="244" y="356" class="gm-label">大门（人民路）</text>
  <!-- 复廊（分隔东西两部） -->
  <line x1="244" y1="70" x2="244" y2="336" stroke="#9c8f74" stroke-width="3"/>
  <g fill="#fdfbf3" stroke="#2c3531" stroke-width="0.6">
    <rect x="240" y="96" width="7" height="7"/><rect x="240" y="136" width="7" height="7"/><rect x="240" y="176" width="7" height="7"/><rect x="240" y="216" width="7" height="7"/><rect x="240" y="256" width="7" height="7"/><rect x="240" y="296" width="7" height="7"/>
  </g>
  <text x="252" y="92" class="gm-label">复廊（隔东西，漏窗式样各异）</text>
  <!-- 西部山水：大假山 -->
  <path class="gm-rock" d="M40,196 C28,150 48,104 96,88 C140,74 176,98 182,142 C188,186 168,232 126,248 C88,262 52,242 40,196 Z"/>
  <g class="gm-rockhatch">
    <path d="M80,170 l12,-16 M108,150 l11,-14 M138,158 l10,-13 M92,206 l12,-14 M124,196 l12,-12 M150,188 l10,-10 M116,112 l9,-11 M144,110 l8,-10"/>
  </g>
  <text x="60" y="270" class="gm-label-big">湖石大假山（谷洞相通）</text>
  <!-- 金粟亭（山顶） -->
  <g class="gm-pav"><rect x="108" y="66" width="16" height="12"/><polygon class="gm-roof" points="105,66 127,66 121,59 111,59"/></g>
  <text x="130" y="78" class="gm-label">金粟亭（桂）</text>
  <!-- 水池 -->
  <path class="gm-water" d="M150,150 C172,128 218,124 244,142 C268,158 272,194 252,218 C228,246 176,250 152,228 C132,208 130,172 150,150 Z"/>
  <path class="gm-ripple" d="M162,168 q14,-4 28,0 M180,196 q14,-4 28,0 M158,216 q12,-3 24,0"/>
  <!-- 北岸：抱绿湾 -->
  <g class="gm-bldg"><rect x="158" y="106" width="56" height="20"/><polygon class="gm-roof" points="152,106 220,106 211,97 161,97"/></g>
  <text x="158" y="96" class="gm-label">抱绿湾</text>
  <!-- 南岸：藕香榭 -->
  <g class="gm-bldg"><rect x="152" y="252" width="64" height="24"/><polygon class="gm-roof" points="146,252 222,252 210,242 158,242"/></g>
  <text x="150" y="296" class="gm-label-big">藕香榭（主厅 · 观荷）</text>
  <!-- 西南：画舫斋 -->
  <g>
    <polygon class="gm-bldg2" points="46,290 106,290 98,278 54,278"/>
    <polygon class="gm-roof" points="62,278 90,266 98,278"/>
    <text x="46" y="312" class="gm-label">画舫斋</text>
  </g>
  <!-- 东南（复廊东端）：小沧浪 -->
  <g class="gm-bldg"><rect x="256" y="252" width="40" height="16"/><polygon class="gm-roof" points="252,252 300,252 293,244 259,244"/></g>
  <text x="258" y="244" class="gm-label">小沧浪（水阁）</text>
  <!-- 东部庭院群 -->
  <rect class="gm-yard" x="262" y="70" width="176" height="160"/>
  <g class="gm-bldg"><rect x="282" y="96" width="60" height="20"/><polygon class="gm-roof" points="277,96 347,96 338,87 286,87"/></g>
  <text x="284" y="86" class="gm-label">坡仙琴馆（北）</text>
  <g class="gm-bldg"><rect x="284" y="144" width="64" height="20"/><polygon class="gm-roof" points="279,144 353,144 343,135 289,135"/></g>
  <text x="286" y="178" class="gm-label">碧梧栖凤馆</text>
  <g class="gm-bldg"><rect x="300" y="196" width="54" height="20"/><polygon class="gm-roof" points="295,196 359,196 350,187 304,187"/></g>
  <text x="360" y="212" class="gm-label">石听琴室</text>
  <g class="gm-pav"><rect x="378" y="96" width="18" height="13"/><polygon class="gm-roof" points="375,96 399,96 393,89 381,89"/></g>
  <text x="368" y="126" class="gm-label">玉延亭</text>
  <text x="270" y="64" class="gm-anno">东部庭院组群（琴馆 · 书斋 · 亭廊）</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="330" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,320 428,334 424,331 420,334" fill="#A94442"/>
    <text x="420" y="354" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="30" y="330" width="24" height="24" rx="3"/>
    <text x="36" y="347" class="gm-sealtext">怡</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-rockhatch { stroke:#9c8f74; stroke-width:.8; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-bldg2 { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
