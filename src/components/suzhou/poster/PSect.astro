---
/* 海报公共件 · 信息栏小节标题 */
interface Props { y: number; title: string }
const { y, title } = Astro.props;
---
<text x="534" y={y} font-size="17" font-weight="700" fill="#2c3531" letter-spacing="4" class="ip-serif">{title}</text>
<line x1="534" y1={y + 8} x2="626" y2={y + 8} stroke="#A94442" stroke-width="2" />
