---
/* 拙政园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="拙政园手绘示意图">
  <!-- 边框 -->
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <!-- 标题 -->
  <text x="26" y="44" class="gm-title">拙政园</text>
  <text x="96" y="44" class="gm-sub">以水见长 · 三分园池 —— 手绘示意，非实测</text>
  <!-- 水面：中部大池 -->
  <path class="gm-water" d="M130,140 C170,118 250,112 300,128 C345,142 352,180 338,214 C322,252 262,272 210,266 C160,260 122,238 118,200 C115,172 112,152 130,140 Z"/>
  <path class="gm-ripple" d="M150,165 q18,-6 36,0 M190,185 q20,-6 40,0 M160,210 q18,-6 36,0 M230,150 q18,-6 36,0"/>
  <!-- 中岛两座 -->
  <ellipse class="gm-land" cx="225" cy="185" rx="46" ry="26"/>
  <ellipse class="gm-land" cx="290" cy="165" rx="30" ry="16"/>
  <!-- 西部补园水面 -->
  <path class="gm-water" d="M356,150 C390,138 428,148 432,180 C436,214 420,246 396,258 C376,268 360,252 358,226 C356,200 348,166 356,150 Z"/>
  <path class="gm-ripple" d="M372,180 q14,-5 28,0 M378,214 q14,-5 28,0"/>
  <!-- 东部花园（独立院落） -->
  <rect class="gm-yard" x="30" y="90" width="86" height="200"/>
  <path class="gm-path" d="M40,272 L40,120 L104,120"/>
  <!-- 建筑 -->
  <g class="gm-bldg"><rect x="56" y="236" width="34" height="20"/><polygon class="gm-roof" points="52,236 94,236 88,228 58,228"/></g>
  <text x="96" y="250" class="gm-label">兰雪堂</text>
  <g class="gm-bldg"><rect x="60" y="128" width="26" height="18"/><polygon class="gm-roof" points="56,128 90,128 85,121 61,121"/></g>
  <text x="42" y="116" class="gm-label">天泉亭</text>
  <g class="gm-bldg"><rect x="40" y="176" width="24" height="16"/><polygon class="gm-roof" points="37,176 67,176 63,169 41,169"/></g>
  <text x="70" y="189" class="gm-label">芙蓉榭</text>
  <!-- 中部 -->
  <g class="gm-pav"><rect x="208" y="176" width="16" height="12"/><polygon class="gm-roof" points="204,176 228,176 222,169 210,169"/></g>
  <text x="186" y="163" class="gm-label-big">荷风四面亭</text>
  <g class="gm-boat"><polygon class="gm-bldg2" points="128,214 172,214 166,204 136,204"/><polygon class="gm-roof" points="136,204 152,194 166,204"/></g>
  <text x="108" y="235" class="gm-label">香洲（画舫）</text>
  <path class="gm-bridge" d="M170,244 Q200,232 226,244"/>
  <text x="168" y="262" class="gm-label">小飞虹</text>
  <g class="gm-bldg"><rect x="128" y="132" width="30" height="18"/><polygon class="gm-roof" points="124,132 162,132 157,124 129,124"/></g>
  <text x="112" y="120" class="gm-label">见山楼</text>
  <g class="gm-pav"><rect x="222" y="120" width="16" height="12"/><polygon class="gm-roof" points="218,120 242,120 236,113 224,113"/></g>
  <text x="244" y="131" class="gm-label">雪香云蔚亭</text>
  <g class="gm-pav"><rect x="284" y="156" width="14" height="11"/><polygon class="gm-roof" points="281,156 301,156 296,149 286,149"/></g>
  <text x="302" y="167" class="gm-label">待霜亭</text>
  <g class="gm-bldg"><rect x="206" y="290" width="56" height="24"/><polygon class="gm-roof" points="200,290 268,290 258,280 210,280"/></g>
  <text x="212" y="330" class="gm-label-big">远香堂（主厅）</text>
  <g class="gm-pav"><rect x="296" y="238" width="15" height="12"/><polygon class="gm-roof" points="293,238 314,238 308,231 299,231"/></g>
  <text x="316" y="250" class="gm-label">梧竹幽居</text>
  <!-- 西部 -->
  <g class="gm-bldg"><rect x="370" y="288" width="58" height="26"/><polygon class="gm-roof" points="364,288 434,288 424,277 374,277"/></g>
  <text x="362" y="330" class="gm-label-big">卅六鸳鸯馆</text>
  <g class="gm-bldg"><rect x="428" y="236" width="20" height="15"/><polygon class="gm-roof" points="425,236 451,236 447,229 429,229"/></g>
  <text x="398" y="228" class="gm-label">留听阁</text>
  <g class="gm-bldg"><rect x="352" y="156" width="20" height="14"/><polygon class="gm-roof" points="349,156 375,156 371,149 353,149"/></g>
  <text x="378" y="168" class="gm-label">倒影楼</text>
  <g class="gm-pav"><rect x="398" y="136" width="16" height="12"/><polygon class="gm-roof" points="395,136 417,136 411,129 401,129"/></g>
  <text x="352" y="126" class="gm-label">浮翠阁</text>
  <g class="gm-pav"><rect x="352" y="212" width="14" height="11"/><polygon class="gm-roof" points="349,212 369,212 364,205 354,205"/></g>
  <text x="330" y="226" class="gm-label">与谁同坐轩</text>
  <!-- 入口 -->
  <path class="gm-path" d="M236,364 L236,318"/>
  <text x="246" y="356" class="gm-label">东入口（东北街）</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="26" y="334" width="24" height="24" rx="3"/>
    <text x="32" y="351" class="gm-sealtext">拙</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-land { fill:#e8dfc8; stroke:#9c8f74; stroke-width:.8; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-bldg2 { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
