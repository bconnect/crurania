---
/* 通用列表页核心 —— 五板块共用 */
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Item {
  id: string;
  data: {
    title?: string;
    book?: string;
    date?: Date;
    year?: number;
    location?: string;
    author?: string;
    rating?: number;
    status?: string;
    medium?: string;
    description?: string;
  };
}
interface Props {
  section: string;      // 路由名
  zh: string;
  en: string;
  items: Item[];
  fmt?: (d: Date) => string;
}
const { section, zh, en, items, fmt } = Astro.props;
const format = fmt ?? ((d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`);
---
<Header current={section} />
<section class="list-head">
  <div class="crumb"><a href="/">CRURANIA</a> / {zh}</div>
  <h1>{zh}</h1>
  <div class="en">{en} · {items.length} 篇</div>
</section>

<section class="list">
  {items.length === 0 && <p class="empty">这里还没有内容。等它生长。</p>}
  {items.map((it) => (
    <a class="row" href={`/${section}/${it.id}/`}>
      <div class="meta">
        {it.data.date && <span class="date">{format(it.data.date)}</span>}
        {it.data.year && <span class="date">{it.data.year}</span>}
        {it.data.location && <span>{it.data.location}</span>}
        {it.data.status && <span class="status">{it.data.status}</span>}
      </div>
      <div class="title">{it.data.title ?? it.data.book}</div>
      <div class="sub">
        {it.data.author && <span>{it.data.author}</span>}
        {it.data.medium && <span>{it.data.medium}</span>}
        {it.data.rating && <span class="stars">{'★'.repeat(it.data.rating)}{'☆'.repeat(5 - it.data.rating)}</span>}
      </div>
    </a>
  ))}
</section>
<Footer editUrl={`https://github.com/bconnect/crurania/tree/main/src/content/${section}`} editLabel="✎ 管理本板块文件 ↗" />

<style>
  .list-head { padding: 64px 48px 32px; border-bottom: 1px solid var(--line); }
  .crumb { font-family: var(--mono); font-size: 11px; color: var(--gray); letter-spacing: .15em; margin-bottom: 20px; }
  .crumb a { border-bottom: 1px solid var(--dawn); }
  .list-head h1 { font-family: var(--serif); font-size: clamp(36px, 6vw, 64px); font-weight: 700; letter-spacing: .06em; }
  .list-head .en { font-family: var(--mono); font-size: 11px; color: var(--gray); letter-spacing: .3em; text-transform: uppercase; margin-top: 12px; }
  .list { padding: 0 48px; }
  .empty { padding: 64px 0; color: var(--gray); font-family: var(--serif); font-size: 18px; }
  .row {
    display: grid; grid-template-columns: 200px 1fr auto; gap: 32px; align-items: baseline;
    padding: 26px 0; border-bottom: 1px solid var(--line);
    transition: background .2s, padding-left .2s;
  }
  .row:hover { background: #f3efe7; padding-left: 14px; }
  .meta { display: flex; gap: 14px; font-family: var(--mono); font-size: 11px; color: var(--gray); flex-wrap: wrap; }
  .meta .date { color: var(--dawn); }
  .meta .status { border: 1px solid var(--line); padding: 0 8px; border-radius: 99px; }
  .title { font-family: var(--serif); font-size: 21px; font-weight: 700; letter-spacing: .04em; }
  .sub { display: flex; gap: 14px; font-size: 12px; color: var(--gray); }
  .sub .stars { color: var(--dawn); letter-spacing: .2em; }
  @media (max-width: 860px) {
    .list-head, .list { padding-left: 22px; padding-right: 22px; }
    .row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
