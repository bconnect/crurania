---
/* 轴测手绘海报 · 退思园（贴水名园 · 退则思过） */
import Frame from '../poster/Frame.astro';
import Clouds from '../poster/Clouds.astro';
import Plaque from '../poster/Plaque.astro';
import PanelFrame from '../poster/PanelFrame.astro';
import PSect from '../poster/PSect.astro';
import Divider from '../poster/Divider.astro';
import RouteScroll from '../poster/RouteScroll.astro';
import Compass from '../poster/Compass.astro';
import Disclaimer from '../poster/Disclaimer.astro';
import VTag from '../poster/VTag.astro';
import RTree from '../poster/RTree.astro';
import Lotus from '../poster/Lotus.astro';
import Seal from '../poster/Seal.astro';
---
<svg class="ip" viewBox="0 0 760 920" role="img" aria-label="退思园手绘游览图">
  <Frame />
  <Clouds />
  <Plaque title="退思园游览图" sub="贴水名园 · 退则思过" />

  <g>
    <PanelFrame />
    <PSect y={158} title="游览特点" />
    <text x="534" y="192" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【贴水名园】</text>
    <text x="534" y="210" font-size="12" fill="#2c3531" class="ip-serif">建筑贴水，如履波上</text>
    <text x="534" y="236" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【退思补过】</text>
    <text x="534" y="254" font-size="12" fill="#2c3531" class="ip-serif">进思尽忠，退思补过</text>

    <Divider y={278} />
    <PSect y={308} title="必打卡景观" />
    <!-- 天桥小图（廊桥） -->
    <g transform="translate(528,330)">
      <path d="M 2,24 Q 22,10 42,24" fill="none" stroke="#2c3531" stroke-width="2" />
      <path d="M 2,24 Q 22,10 42,24 L 42,28 Q 22,14 2,28 Z" fill="#d9d0ba" stroke="#2c3531" stroke-width="0.6" />
      <path d="M 0,16 Q 22,2 44,16 L 44,22 Q 22,8 0,22 Z" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    </g>
    <text x="586" y="342" font-size="13" font-weight="700" fill="#2c3531" class="ip-serif">天桥</text>
    <text x="586" y="360" font-size="11" fill="#5c5548" class="ip-serif">廊桥卧波，连接辛台</text>
    <!-- 退思草堂小图 -->
    <g transform="translate(530,384)">
      <rect x="2" y="14" width="46" height="16" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
      <line x1="11" y1="14" x2="11" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="21" y1="14" x2="21" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="31" y1="14" x2="31" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="40" y1="14" x2="40" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <polygon points="-2,16 52,16 56,12 46,2 4,2 -6,12" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    </g>
    <text x="586" y="394" font-size="13" font-weight="700" fill="#2c3531" class="ip-serif">退思草堂</text>
    <text x="586" y="412" font-size="11" fill="#5c5548" class="ip-serif">正对荷池，倒影成双</text>

    <Divider y={434} />
    <PSect y={466} title="推荐路线" />
    <RouteScroll y={486} lines={["住宅 → 月洞门 → 琴房", "→ 退思草堂 → 绕池 → 天桥", "→ 辛台 → 菰雨生凉 → 眠云亭"]} />

    <PSect y={612} title="贴士" />
    <text x="534" y="644" font-size="11.5" fill="#2c3531" class="ip-serif">※ 拍倒影须风平浪静之晨</text>
    <text x="534" y="664" font-size="11.5" fill="#2c3531" class="ip-serif">※ 同里古镇联游，清晨最静</text>

    <Compass x={668} y={768} />
    <Disclaimer />
  </g>

  <!-- ═══ 主景 ═══ -->
  <!-- 荷花池（镜面大池，建筑贴水） -->
  <path d="M 166,446 C 196,424 256,416 306,426 C 350,435 388,448 400,482 C 410,514 402,566 380,598 C 352,636 296,650 246,640 C 200,630 168,598 160,548 C 154,502 150,470 166,446 Z" fill="#c3e2db" stroke="#7fa398" stroke-width="1.2" />
  <path d="M 220,500 q 10,-5 20,0 M 300,540 q 10,-5 20,0 M 250,586 q 10,-5 20,0" stroke="#7fa398" stroke-width="0.8" fill="none" />
  <Lotus x={230} y={540} />
  <Lotus x={320} y={500} />

  <!-- 住宅（西） -->
  <line x1="40" y1="556" x2="40" y2="726" stroke="#2c3531" stroke-width="1.4" />
