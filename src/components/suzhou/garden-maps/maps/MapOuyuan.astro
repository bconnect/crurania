---
/* 耦园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="耦园手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">耦园</text>
  <text x="200" y="44" class="gm-sub">一宅两园 · 耦耕归隐 —— 手绘示意，非实测</text>
  <!-- 中部住宅 -->
  <rect class="gm-yard" x="182" y="200" width="96" height="150"/>
  <path class="gm-path" d="M230,350 L230,206"/>
  <g class="gm-bldg"><rect x="198" y="212" width="64" height="22"/><polygon class="gm-roof" points="192,212 268,212 258,203 202,203"/></g>
  <text x="200" y="248" class="gm-label">载酒堂（主厅）</text>
  <g class="gm-bldg"><rect x="200" y="276" width="60" height="30"/><polygon class="gm-roof" points="194,276 266,276 256,266 204,266"/></g>
  <text x="202" y="322" class="gm-label">内宅 · 走马楼</text>
  <text x="210" y="344" class="gm-anno">（楼廊贯通东西花园）</text>
  <text x="226" y="366" class="gm-label">门厅（南）</text>
  <!-- 东花园 -->
  <rect class="gm-yard" x="292" y="176" width="152" height="150"/>
  <!-- 受月池 -->
  <path class="gm-water" d="M300,262 C320,246 352,246 366,260 C378,274 370,296 348,304 C324,312 300,302 296,284 C294,274 294,270 300,262 Z"/>
  <path class="gm-ripple" d="M312,272 q12,-4 24,0 M316,288 q10,-3 20,0"/>
  <!-- 黄石假山（东南主景） -->
  <path class="gm-rock" d="M360,300 C352,272 368,246 396,240 C420,236 434,254 430,280 C426,306 404,322 384,320 C370,318 364,314 360,300 Z"/>
  <g class="gm-rockhatch">
    <path d="M380,288 l10,-14 M398,278 l9,-12 M386,306 l10,-12 M410,296 l9,-10"/>
  </g>
  <text x="330" y="336" class="gm-label-big">黄石假山（东园主景）</text>
  <!-- 城曲草堂 -->
  <g class="gm-bldg"><rect x="330" y="196" width="56" height="20"/><polygon class="gm-roof" points="325,196 391,196 382,187 334,187"/></g>
  <text x="330" y="232" class="gm-label">城曲草堂（东园主厅）</text>
  <!-- 山水间 -->
  <g class="gm-bldg"><rect x="400" y="252" width="32" height="16"/><polygon class="gm-roof" points="396,252 436,252 430,244 402,244"/></g>
  <text x="394" y="244" class="gm-label">山水间（水阁）</text>
  <!-- 东墙借古城 -->
  <line x1="448" y1="176" x2="448" y2="326" stroke="#9c8f74" stroke-width="2" stroke-dasharray="8 4"/>
  <text x="396" y="170" class="gm-anno">东墙外借古城垣景色</text>
  <!-- 西花园 -->
  <rect class="gm-yard" x="20" y="196" width="142" height="130"/>
  <!-- 西园湖石山 -->
  <path class="gm-rock" d="M60,296 C54,272 68,250 92,246 C114,242 126,260 122,284 C118,306 96,318 78,314 C68,311 63,308 60,296 Z"/>
  <g class="gm-rockhatch">
    <path d="M80,288 l9,-12 M96,280 l8,-10 M84,302 l9,-10"/>
  </g>
  <text x="60" y="332" class="gm-label">湖石小山（西园）</text>
  <!-- 织帘老屋 -->
  <g class="gm-bldg"><rect x="48" y="212" width="56" height="20"/><polygon class="gm-roof" points="43,212 109,212 100,203 52,203"/></g>
  <text x="48" y="248" class="gm-label">织帘老屋（书斋）</text>
  <!-- 双园连接 -->
  <path class="gm-path" d="M182,260 L162,260 M298,262 L278,262"/>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="80" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,70 428,84 424,81 420,84" fill="#A94442"/>
    <text x="420" y="104" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="30" y="110" width="24" height="24" rx="3"/>
    <text x="36" y="127" class="gm-sealtext">耦</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-rockhatch { stroke:#9c8f74; stroke-width:.8; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
