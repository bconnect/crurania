---
/* 海报公共件 · 湖石（含卷云纹） */
interface Props { x: number; y: number; s?: number; tone?: number }
const { x, y, s = 1, tone = 0 } = Astro.props;
const F = tone === 1 ? '#a8a294' : '#b8b3a6';
---
<g transform={`translate(${x},${y}) scale(${s})`} stroke="#8a857a" stroke-width="0.9" fill={F}>
  <path d="M 0,15 c -6,-8 2,-18 12,-15 c 3,-7 14,-7 17,0 c 9,-2 15,7 10,14 c 5,6 -1,14 -9,13 c -3,6 -13,6 -16,0 c -8,2 -15,-4 -14,-12 z" />
  <path d="M 10,11 c 3,-4 9,-3 10,2 M 16,19 c 3,-2 7,0 7,4" stroke="#7a7568" stroke-width="0.6" fill="none" />
</g>
