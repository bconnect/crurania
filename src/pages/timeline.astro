---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('timeline')).sort((a, b) =>
  b.data.year - a.data.year || (b.data.order ?? 0) - (a.data.order ?? 0));
const years = [...new Set(items.map((i) => i.data.year))];
---
<Base title="大事记">
  <Header current="timeline" />
  <section class="list-head">
    <div class="crumb"><a href="/">CRURANIA</a> / 大事记</div>
    <h1>大事记</h1>
    <div class="en">Timeline · {items.length} 个坐标</div>
  </section>
  <section class="tl">
    {years.map((y) => (
      <div class="year-block">
        <div class="year">{y}</div>
        <div class="events">
          {items.filter((i) => i.data.year === y).map((e) => (
            <div class={`event${e.data.highlight ? ' hot' : ''}`}>
              <span class="dot" />
              <div>
                <div class="t">{e.data.title}</div>
                {e.body.trim() && <div class="d">{e.body.trim()}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
  <Footer />
</Base>

<style>
  .list-head { padding: 64px 48px 32px; border-bottom: 1px solid var(--line); }
  .crumb { font-family: var(--mono); font-size: 11px; color: var(--gray); letter-spacing: .15em; margin-bottom: 20px; }
  .crumb a { border-bottom: 1px solid var(--dawn); }
  .list-head h1 { font-family: var(--serif); font-size: clamp(36px, 6vw, 64px); font-weight: 700; letter-spacing: .06em; }
  .list-head .en { font-family: var(--mono); font-size: 11px; color: var(--gray); letter-spacing: .3em; text-transform: uppercase; margin-top: 12px; }
  .tl { padding: 48px; max-width: 760px; }
  .year-block { display: grid; grid-template-columns: 110px 1fr; gap: 32px; padding-bottom: 40px; }
  .year { font-family: var(--serif); font-size: 34px; font-weight: 300; color: var(--ink); text-align: right; line-height: 1.3; }
  .events { border-left: 1px solid var(--ink); padding-left: 28px; display: flex; flex-direction: column; gap: 22px; }
  .event { position: relative; }
  .event .dot { position: absolute; left: -33px; top: 8px; width: 9px; height: 9px; border-radius: 50%; background: var(--paper); border: 1.5px solid var(--ink); }
  .event.hot .dot { background: var(--dawn); border-color: var(--dawn); }
  .event .t { font-family: var(--serif); font-size: 17px; font-weight: 700; letter-spacing: .04em; }
  .event.hot .t { color: var(--dawn); }
  .event .d { font-size: 13px; color: #55524c; margin-top: 4px; }
  @media (max-width: 860px) {
    .list-head, .tl { padding-left: 22px; padding-right: 22px; }
    .year-block { grid-template-columns: 1fr; gap: 12px; padding-bottom: 32px; }
    .year { text-align: left; }
  }
</style>
