    <rect x="388" y="644" width="88" height="30" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.2" />
    <rect x="396" y="652" width="34" height="14" fill="#4a564f" />
    <rect x="436" y="652" width="34" height="14" fill="#4a564f" />
    <line x1="432" y1="644" x2="432" y2="674" stroke="#2c3531" stroke-width="0.8" />
    <polygon points="382,646 482,646 488,640 474,626 390,626 376,640" fill="#4a564f" stroke="#333d38" stroke-width="0.9" />
    <polygon points="392,626 472,626 464,618 400,618" fill="#67756c" stroke="#333d38" stroke-width="0.8" />
    <line x1="416" y1="618" x2="448" y2="618" stroke="#333d38" stroke-width="1.8" />
