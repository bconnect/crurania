    <line x1="454" y1="514" x2="454" y2="521" stroke="#2c3531" stroke-width="0.7" />
  </g>

  <!-- 坐春望月楼（东，两层长楼） -->
  <g>
    <rect x="400" y="562" width="72" height="15" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <rect x="408" y="542" width="56" height="12" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <polygon points="394,564 478,564 482,560 470,550 402,550 390,560" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
