    <rect x="106" y="548" width="12" height="16" fill="#4a564f" />
    <rect x="124" y="548" width="12" height="16" fill="#4a564f" />
    <polygon points="56,542 148,542 156,534 142,520 62,520 48,534" fill="#4a564f" stroke="#333d38" stroke-width="0.9" />
    <polygon points="66,520 138,520 130,512 74,512" fill="#67756c" stroke="#333d38" stroke-width="0.8" />
    <line x1="88" y1="512" x2="116" y2="512" stroke="#333d38" stroke-width="2" />
  </g>

  <!-- 石林小院（揖峰轩） -->
  <Rock x={176} y={598} s={0.7} />
  <Rock x={198} y={590} s={0.55} tone={1} />
  <Rock x={188} y={614} s={0.5} />
  <Rock x={210} y={608} s={0.4} tone={1} />
  <g>
    <rect x="164" y="642" width="40" height="15" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <line x1="174" y1="642" x2="174" y2="657" stroke="#2c3531" stroke-width="0.6" />
    <line x1="184" y1="642" x2="184" y2="657" stroke="#2c3531" stroke-width="0.6" />
    <line x1="194" y1="642" x2="194" y2="657" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="158,644 210,644 214,640 204,630 164,630 154,640" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
  </g>

  <!-- 冠云峰（独立高耸） -->
  <g stroke="#8a857a" fill="#b8b3a6">
    <ellipse cx="432" cy="522" rx="27" ry="16" />
    <ellipse cx="428" cy="486" rx="21" ry="24" />
    <ellipse cx="434" cy="448" rx="14" ry="18" />
    <ellipse cx="430" cy="420" rx="8" ry="12" />
    <path d="M 424,480 c 4,-5 10,-4 12,1 M 428,450 c 3,-4 8,-3 9,1 M 426,512 c 4,-4 10,-3 11,2 M 428,414 c 2,-3 6,-2 6,1" stroke="#7a7568" stroke-width="0.7" fill="none" />
  </g>
  <path d="M 404,540 C 418,530 448,530 462,542 L 462,548 L 404,548 Z" fill="#b8b3a6" stroke="#8a857a" stroke-width="0.8" />
  <!-- 冠云楼 -->
  <g>
    <rect x="398" y="566" width="62" height="26" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.1" />
    <line x1="408" y1="566" x2="408" y2="592" stroke="#2c3531" stroke-width="0.6" />
