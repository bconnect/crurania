  <path d="M 226,560 q 10,-5 20,0 M 300,616 q 10,-5 20,0 M 246,640 q 10,-5 20,0" stroke="#7fa398" stroke-width="0.8" fill="none" />
  <Lotus x={216} y={606} />
  <Lotus x={310} y={570} />

  <!-- 小蓬莱 + 双桥 -->
