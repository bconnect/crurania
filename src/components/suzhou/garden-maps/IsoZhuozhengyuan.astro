    <PanelFrame />
    <PSect y={158} title="游览特点" />
    <text x="534" y="192" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【移步换景】</text>
    <text x="534" y="210" font-size="12" fill="#2c3531" class="ip-serif">随步而变，一步一景</text>
    <text x="534" y="236" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【借景手法】</text>
    <text x="534" y="254" font-size="12" fill="#2c3531" class="ip-serif">远借北寺塔，入园即成景</text>

