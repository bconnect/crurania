---
/* 苏州三日 · 专题门户 */
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import TocRow from '../../../components/TocRow.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('suzhou')).filter((e) => !e.data.draft);
const byType = (t: string) => all.filter((e) => e.data.type === t);
const plan = byType('plan')[0];
const notes = byType('note').sort((a, b) => (a.data.day ?? 0) - (b.data.day ?? 0));
const photos = byType('photo');
const places = byType('place');
const anecdotes = byType('anecdote');
const done = (arr: unknown[]) => arr.filter((e: any) => !e.data.draft).length;
const fmt = (d?: Date) => d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';
---
<Base title="苏州三日" description="2026年11月 · 苏州：三天计划、笔记、照片、时间表、地点与野史。">
  <Header current="travel" />
  <section class="hero">
    <div class="crumb"><a href="/">CRURANIA</a> / <a href="/travel">旅游纪实</a> / 苏州三日</div>
    <h1>苏州三日</h1>
    <div class="en">SUZHOU · 2026.11.24 — 11.26</div>
    <p class="lede">十一月下旬下江南：三座园林、一条古街、一碗头汤面、一笼大闸蟹。</p>
  </section>

  <nav class="toc">
    <TocRow num="01" zh="行前计划" en="Plan" desc="三天行程全案：路线、时刻、吃单、摄影备忘" latestTitle={plan?.data.title} latestDate={plan ? fmt(plan.data.date) : ''} count={done([plan]) || undefined} href="/travel/suzhou/plan/" />
    <TocRow num="02" zh="旅行笔记" en="Notes" desc="每天一篇，回来后慢慢写" latestTitle={notes[0]?.data.title} latestDate={notes[0] ? fmt(notes[0].data.date) : ''} count={done(notes) || undefined} href="/travel/suzhou/notes/" />
    <TocRow num="03" zh="照片" en="Photos" desc="此行的照片墙，回来后上传" count={done(photos) || undefined} href="/travel/suzhou/photos/" />
    <TocRow num="04" zh="时间表" en="Timetable" desc="数据驱动：改数据文件即自动重建" href="/travel/suzhou/timeline/" />
    <TocRow num="05" zh="地点" en="Places" desc="每处名胜的介绍与索引" count={done(places) || undefined} href="/travel/suzhou/places/" />
    <TocRow num="06" zh="野史" en="Anecdotes" desc="正史之外的苏州，出处放文末" count={done(anecdotes) || undefined} href="/travel/suzhou/anecdotes/" />
  </nav>

  <Footer editUrl="https://github.com/bconnect/crurania/tree/main/src/content/suzhou" editLabel="✎ 管理本专题文件 ↗" />
</Base>

<style>
  .hero { padding: 72px 48px 40px; border-bottom: 1px solid var(--line); }
  .crumb { font-family: var(--mono); font-size: 11px; color: var(--gray); letter-spacing: .15em; margin-bottom: 24px; }
  .crumb a { border-bottom: 1px solid var(--dawn); }
  .hero h1 { font-family: var(--serif); font-size: clamp(44px, 8vw, 84px); font-weight: 700; letter-spacing: .08em; line-height: 1.1; }
  .hero .en { font-family: var(--mono); font-size: 12px; color: var(--dawn); letter-spacing: .35em; text-transform: uppercase; margin-top: 16px; }
  .lede { font-family: var(--serif); font-size: 17px; color: #55524c; margin-top: 24px; max-width: 34em; }
  .toc { padding: 0 48px 64px; }
  @media (max-width: 860px) { .hero, .toc { padding-left: 22px; padding-right: 22px; } }
</style>
