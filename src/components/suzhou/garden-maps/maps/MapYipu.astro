---
/* 艺圃 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="艺圃手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">艺圃</text>
  <text x="70" y="44" class="gm-sub">乳鱼亭畔 · 巷深藏圃 —— 手绘示意，非实测</text>
  <!-- 东部住宅 -->
  <rect class="gm-yard" x="330" y="240" width="110" height="110"/>
  <g class="gm-bldg"><rect x="348" y="270" width="64" height="22"/><polygon class="gm-roof" points="342,270 418,270 408,261 352,261"/></g>
  <text x="352" y="308" class="gm-label">住宅厅堂</text>
  <path class="gm-path" d="M385,240 L385,150 L300,150"/>
  <text x="392" y="236" class="gm-label">入口（文衙弄）</text>
  <!-- 水池 -->
  <path class="gm-water" d="M82,168 C110,132 190,124 232,148 C266,168 272,214 246,244 C214,278 132,282 96,254 C66,230 60,196 82,168 Z"/>
  <path class="gm-ripple" d="M104,180 q16,-5 32,0 M148,204 q18,-5 36,0 M112,232 q14,-4 28,0 M196,164 q14,-4 28,0"/>
  <!-- 北岸：博雅堂 -->
  <g class="gm-bldg"><rect x="130" y="96" width="62" height="24"/><polygon class="gm-roof" points="124,96 198,96 188,86 134,86"/></g>
  <text x="126" y="82" class="gm-label-big">博雅堂（主厅）</text>
  <!-- 北岸土山与朝爽亭 -->
  <path class="gm-rock" d="M208,110 C220,84 258,78 274,98 C286,114 274,132 246,134 C224,136 200,128 208,110 Z"/>
  <g class="gm-pav"><rect x="238" y="64" width="16" height="12"/><polygon class="gm-roof" points="235,64 257,64 251,57 241,57"/></g>
  <text x="260" y="76" class="gm-label">朝爽亭</text>
  <text x="212" y="126" class="gm-anno">土山枫树</text>
  <!-- 南岸：延光阁 -->
  <g class="gm-bldg"><rect x="118" y="262" width="92" height="18"/><polygon class="gm-roof" points="112,262 216,262 206,253 122,253"/></g>
  <text x="118" y="298" class="gm-label-big">延光阁（大水榭 · 茶室）</text>
  <!-- 东岸：乳鱼亭 -->
  <g class="gm-pav"><rect x="252" y="196" width="18" height="14"/><polygon class="gm-roof" points="248,196 274,196 268,188 254,188"/></g>
  <text x="278" y="210" class="gm-label-big">乳鱼亭</text>
  <path class="gm-bridge" d="M252,238 q14,-10 28,-4"/>
  <text x="284" y="246" class="gm-label">度香桥</text>
  <!-- 西岸：响月廊、芹庐 -->
  <line x1="72" y1="160" x2="72" y2="240" stroke="#9c8f74" stroke-width="3"/>
  <text x="34" y="200" class="gm-label" transform="rotate(-90 40 200)">响月廊</text>
  <g class="gm-bldg"><rect x="42" y="110" width="34" height="18"/><polygon class="gm-roof" points="38,110 80,110 74,102 44,102"/></g>
  <text x="42" y="96" class="gm-label">芹庐</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="30" y="330" width="24" height="24" rx="3"/>
    <text x="36" y="347" class="gm-sealtext">艺</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
