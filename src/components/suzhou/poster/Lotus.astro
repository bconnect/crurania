---
/* 海报公共件 · 荷丛 */
interface Props { x: number; y: number }
const { x, y } = Astro.props;
---
<g stroke="#4e7038" stroke-width="0.7">
  <ellipse cx={x - 12} cy={y + 6} rx="10" ry="4" fill="#6a914d" />
  <ellipse cx={x + 2} cy={y - 2} rx="9" ry="4" fill="#7fa05a" />
  <ellipse cx={x + 12} cy={y + 8} rx="8" ry="3.5" fill="#6a914d" />
  <ellipse cx={x - 4} cy={y + 14} rx="7" ry="3" fill="#54763d" />
  <ellipse cx={x + 18} cy={y} rx="7" ry="3" fill="#7fa05a" />
</g>
<g fill="#e8a0b4" stroke="#c47a92" stroke-width="0.6">
  <circle cx={x - 6} cy={y} r="3.2" />
  <circle cx={x + 8} cy={y + 10} r="3.2" />
</g>
