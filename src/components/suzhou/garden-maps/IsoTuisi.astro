        fill="none" stroke="#8a7d63" stroke-width="2" stroke-dasharray="6 5" />
  <g fill="#8a7d63">
    <ellipse cx="146" cy="606" rx="2.2" ry="3" /><ellipse cx="150" cy="614" rx="2.2" ry="3" />
    <ellipse cx="168" cy="480" rx="2.2" ry="3" /><ellipse cx="172" cy="488" rx="2.2" ry="3" />
    <ellipse cx="216" cy="420" rx="2.2" ry="3" /><ellipse cx="220" cy="428" rx="2.2" ry="3" />
    <ellipse cx="300" cy="586" rx="2.2" ry="3" /><ellipse cx="304" cy="594" rx="2.2" ry="3" />
    <ellipse cx="372" cy="512" rx="2.2" ry="3" /><ellipse cx="376" cy="520" rx="2.2" ry="3" />
    <ellipse cx="416" cy="424" rx="2.2" ry="3" /><ellipse cx="420" cy="432" rx="2.2" ry="3" />
    <ellipse cx="436" cy="500" rx="2.2" ry="3" /><ellipse cx="440" cy="508" rx="2.2" ry="3" />
    <ellipse cx="428" cy="580" rx="2.2" ry="3" /><ellipse cx="432" cy="588" rx="2.2" ry="3" />
    <ellipse cx="388" cy="640" rx="2.2" ry="3" /><ellipse cx="392" cy="648" rx="2.2" ry="3" />
    <ellipse cx="316" cy="678" rx="2.2" ry="3" /><ellipse cx="320" cy="686" rx="2.2" ry="3" />
    <ellipse cx="230" cy="662" rx="2.2" ry="3" /><ellipse cx="234" cy="670" rx="2.2" ry="3" />
  </g>

  <!-- ═══ 竖排标签 ═══ -->
  <VTag x={118} y={536} chars="住宅" />
  <VTag x={126} y={430} chars="琴房" />
  <VTag x={350} y={372} chars="退思草堂" />
