    <polygon points="400,548 458,548 450,540 408,540" fill="#67756c" stroke="#333d38" stroke-width="0.8" />
    <line x1="420" y1="540" x2="440" y2="540" stroke="#333d38" stroke-width="1.8" />
  </g>

  <!-- 林泉耆硕之馆（鸳鸯厅） -->
