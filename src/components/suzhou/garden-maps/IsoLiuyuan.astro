    <line x1="304" y1="658" x2="304" y2="667" stroke="#f7f1e3" stroke-width="1" />
    <polygon points="208,654 326,654 332,648 318,634 216,634 202,648" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
    <line x1="240" y1="634" x2="292" y2="634" stroke="#333d38" stroke-width="1.8" />
  </g>

  <!-- 五峰仙馆（江南第一厅，面阔最大） -->
  <g>
    <rect x="52" y="570" width="100" height="13" fill="#ddd3bc" stroke="#2c3531" stroke-width="0.9" />
    <rect x="60" y="540" width="84" height="30" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.3" />
    <rect x="70" y="548" width="12" height="16" fill="#4a564f" />
