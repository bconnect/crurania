---
/* 留园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="留园手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">留园</text>
  <text x="200" y="44" class="gm-sub">空间变幻 · 奇石之冠 —— 手绘示意，非实测</text>
  <!-- 北部竹圃 -->
  <rect class="gm-yard" x="130" y="22" width="240" height="26"/>
  <text x="238" y="40" class="gm-anno">竹 圃（北）</text>
  <!-- 中部水池 -->
  <path class="gm-water" d="M115,95 C150,70 230,66 268,84 C300,100 306,136 288,162 C266,192 196,200 155,184 C118,170 100,124 115,95 Z"/>
  <path class="gm-ripple" d="M140,110 q16,-5 32,0 M180,130 q18,-5 36,0 M150,155 q16,-5 32,0 M225,105 q14,-4 28,0"/>
  <!-- 池中岛：小蓬莱 -->
  <ellipse class="gm-land" cx="225" cy="130" rx="26" ry="13"/>
  <path class="gm-bridge" d="M195,142 Q210,134 224,138"/>
  <!-- 西岸 -->
  <g class="gm-bldg"><rect x="82" y="112" width="22" height="15"/><polygon class="gm-roof" points="79,112 107,112 103,105 83,105"/></g>
  <text x="44" y="124" class="gm-label">远翠阁</text>
  <g class="gm-pav"><rect x="62" y="150" width="16" height="12"/><polygon class="gm-roof" points="59,150 81,150 75,143 65,143"/></g>
  <text x="30" y="162" class="gm-label">闻木樨香轩</text>
  <!-- 南岸主厅：明瑟楼·涵碧山房 -->
  <g class="gm-bldg"><rect x="130" y="188" width="64" height="24"/><polygon class="gm-roof" points="124,188 200,188 190,178 134,178"/></g>
  <text x="124" y="228" class="gm-label-big">涵碧山房 · 明瑟楼</text>
  <!-- 濠濮亭 -->
  <g class="gm-pav"><rect x="238" y="150" width="15" height="11"/><polygon class="gm-roof" points="235,150 256,150 250,143 241,143"/></g>
  <text x="258" y="161" class="gm-label">濠濮亭</text>
  <text x="216" y="146" class="gm-label">小蓬莱</text>
  <!-- 东部庭院群 -->
  <g class="gm-bldg"><rect x="222" y="205" width="54" height="24"/><polygon class="gm-roof" points="216,205 282,205 272,195 226,195"/></g>
  <text x="284" y="222" class="gm-label-big">五峰仙馆（楠木厅）</text>
  <rect class="gm-yard" x="288" y="238" width="40" height="34"/>
  <text x="282" y="262" class="gm-label" transform="rotate(0)">石林小院</text>
  <g class="gm-bldg"><rect x="300" y="160" width="56" height="24"/><polygon class="gm-roof" points="294,160 362,160 352,150 304,150"/></g>
  <text x="312" y="146" class="gm-label">林泉耆硕之馆（鸳鸯厅）</text>
  <!-- 冠云峰庭院 -->
  <path class="gm-rock" d="M322,88 l10,-22 12,22 z"/>
  <text x="342" y="80" class="gm-label-big">冠云峰</text>
  <path class="gm-rock" d="M356,96 l7,-14 8,14 z"/>
  <text x="368" y="106" class="gm-label">瑞云·岫云</text>
  <ellipse class="gm-water" cx="330" cy="112" rx="22" ry="8"/>
  <text x="310" y="130" class="gm-label">浣云沼</text>
  <g class="gm-bldg"><rect x="366" y="52" width="34" height="18"/><polygon class="gm-roof" points="362,52 404,52 398,44 368,44"/></g>
  <text x="408" y="66" class="gm-label">冠云楼</text>
  <!-- 南部入口与曲廊 -->
  <path class="gm-path" d="M52,344 L52,300 Q52,280 70,272 L120,258 L130,250"/>
  <text x="30" y="358" class="gm-label">入口 · 曲廊（五十米）</text>
  <g class="gm-pav"><rect x="108" y="236" width="16" height="12"/><polygon class="gm-roof" points="105,236 127,236 121,229 111,229"/></g>
  <text x="130" y="248" class="gm-label">曲溪楼</text>
  <text x="56" y="300" class="gm-label">古木交柯</text>
  <!-- 西部土阜枫林 -->
  <path class="gm-land" d="M20,190 C50,178 90,190 95,225 C100,262 78,300 48,302 C24,304 16,260 18,228 Z"/>
  <text x="30" y="246" class="gm-anno" transform="rotate(-72 40 250)">西部土阜 · 枫林（秋）</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="394" y="330" width="24" height="24" rx="3"/>
    <text x="400" y="347" class="gm-sealtext">留</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-land { fill:#e8dfc8; stroke:#9c8f74; stroke-width:.8; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
