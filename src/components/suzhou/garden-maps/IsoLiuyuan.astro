    <line x1="430" y1="566" x2="430" y2="592" stroke="#2c3531" stroke-width="0.6" />
    <line x1="441" y1="566" x2="441" y2="592" stroke="#2c3531" stroke-width="0.6" />
    <line x1="452" y1="566" x2="452" y2="592" stroke="#2c3531" stroke-width="0.6" />
