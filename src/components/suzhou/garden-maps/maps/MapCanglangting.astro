---
/* 沧浪亭 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="沧浪亭手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">沧浪亭</text>
  <text x="112" y="44" class="gm-sub">未入园门先见水 —— 手绘示意，非实测</text>
  <!-- 园外葑溪（南侧，借景） -->
  <path class="gm-water" d="M14,330 C90,318 200,324 280,320 C350,317 420,322 446,318 L446,352 L14,352 Z"/>
  <path class="gm-ripple" d="M40,338 q18,-4 36,0 M130,340 q18,-4 36,0 M240,336 q18,-4 36,0 M340,338 q18,-4 36,0"/>
  <text x="330" y="346" class="gm-water-label">葑 溪（园外 · 借景）</text>
  <!-- 石桥与园门 -->
  <path class="gm-bridge" d="M62,318 Q80,306 98,318"/>
  <text x="46" y="312" class="gm-label">石桥</text>
  <g class="gm-bldg"><rect x="108" y="292" width="26" height="18"/><polygon class="gm-roof" points="104,292 138,292 132,284 110,284"/></g>
  <text x="142" y="306" class="gm-label">园门</text>
  <!-- 复廊（沿南墙，漏窗） -->
  <line x1="60" y1="278" x2="420" y2="278" stroke="#9c8f74" stroke-width="3"/>
  <g fill="#fdfbf3" stroke="#2c3531" stroke-width="0.6">
    <rect x="90" y="272" width="7" height="7"/><rect x="130" y="272" width="7" height="7"/><rect x="170" y="272" width="7" height="7"/><rect x="210" y="272" width="7" height="7"/><rect x="250" y="272" width="7" height="7"/><rect x="290" y="272" width="7" height="7"/><rect x="330" y="272" width="7" height="7"/><rect x="370" y="272" width="7" height="7"/>
  </g>
  <text x="302" y="268" class="gm-label">复廊（漏窗式样各异）</text>
  <g class="gm-pav"><rect x="228" y="252" width="26" height="16"/><polygon class="gm-roof" points="224,252 258,252 252,244 230,244"/></g>
  <text x="264" y="266" class="gm-label">面水轩</text>
  <!-- 中央土山（黄石） -->
  <path class="gm-rock" d="M150,232 C140,200 158,168 196,152 C236,136 282,146 298,178 C312,208 300,240 268,252 C228,266 168,262 150,232 Z"/>
  <g class="gm-rockhatch">
    <path d="M180,200 l14,-18 M210,190 l12,-16 M246,196 l12,-14 M270,214 l12,-12 M190,232 l14,-14 M230,226 l14,-12"/>
  </g>
  <!-- 古树 -->
  <g class="gm-tree">
    <circle cx="196" cy="170" r="9"/><circle cx="252" cy="160" r="10"/><circle cx="222" cy="212" r="8"/>
  </g>
  <!-- 山顶沧浪亭 -->
  <g class="gm-pav"><rect x="220" y="118" width="20" height="14"/><polygon class="gm-roof" points="216,118 244,118 238,110 222,110"/></g>
  <text x="252" y="130" class="gm-label-big">沧浪亭（山顶）</text>
  <!-- 山南建筑群 -->
  <g class="gm-bldg"><rect x="196" y="256" width="64" height="24"/><polygon class="gm-roof" points="190,256 266,256 256,246 200,246"/></g>
  <text x="200" y="300" class="gm-label-big">明道堂（主厅）</text>
  <g class="gm-bldg"><rect x="300" y="246" width="40" height="18"/><polygon class="gm-roof" points="296,246 344,246 337,238 303,238"/></g>
  <text x="350" y="260" class="gm-label">闻妙香室</text>
  <g class="gm-bldg"><rect x="120" y="246" width="40" height="18"/><polygon class="gm-roof" points="116,246 164,246 157,238 123,238"/></g>
  <text x="60" y="240" class="gm-label">五百名贤祠</text>
  <!-- 看山楼（西南角） -->
  <g class="gm-bldg"><rect x="58" y="196" width="26" height="34"/><polygon class="gm-roof" points="54,196 88,196 82,188 60,188"/></g>
  <text x="30" y="186" class="gm-label">看山楼</text>
  <!-- 山北：翠玲珑 -->
  <g class="gm-bldg"><rect x="300" y="150" width="40" height="18"/><polygon class="gm-roof" points="296,150 344,150 337,142 303,142"/></g>
  <text x="350" y="164" class="gm-label">翠玲珑（竹馆）</text>
  <!-- 山北小池 -->
  <ellipse class="gm-water" cx="190" cy="122" rx="34" ry="12"/>
  <text x="150" y="108" class="gm-label">山池</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="26" y="120" width="24" height="24" rx="3"/>
    <text x="32" y="137" class="gm-sealtext">沧</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-water-label { font-size:11px; fill:#5f8579; letter-spacing:2px; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-rockhatch { stroke:#9c8f74; stroke-width:.8; }
  .gm-tree { fill:none; stroke:#5a6b5c; stroke-width:1.2; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
