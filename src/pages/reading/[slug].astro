---
import Base from '../../layouts/Base.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const entries = (await getCollection('reading')).filter((e) => !e.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<Base title={entry.data.title ?? entry.data.book ?? '读书笔记'}>
  <ArticlePage entry={entry} section="reading" zh="读书笔记" />
</Base>
