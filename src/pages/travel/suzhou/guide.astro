<script define:vars={{ spots }}>
  // 地图点位联动
  const panel = {
    badge: document.getElementById('p-badge'),
    area: document.getElementById('p-area'),
    title: document.getElementById('p-title'),
    subtitle: document.getElementById('p-subtitle'),
    desc: document.getElementById('p-desc'),
    tip: document.getElementById('p-tip'),
  };
  function selectSpot(key) {
    const d = spots[key];
    if (!d) return;
    panel.badge.textContent = d.badge;
    panel.area.textContent = d.area;
    panel.title.textContent = d.title;
    panel.subtitle.textContent = d.subtitle;
    panel.desc.textContent = d.desc;
    panel.tip.textContent = d.tip;
    document.querySelectorAll('#sz-map .spot').forEach((n) => {
      const on = n.getAttribute('data-spot') === key;
      const dot = n.querySelector('.dot');
      const pulse = n.querySelector('.pulse');
      if (dot) { dot.setAttribute('fill', on ? 'var(--dawn)' : (n.getAttribute('data-spot') === 'shantang' ? 'var(--gray)' : 'var(--ink)')); dot.setAttribute('r', on ? '8.5' : '7'); }
      if (pulse) { pulse.setAttribute('opacity', on ? '0.3' : '0.14'); }
    });
  }
  document.querySelectorAll('#sz-map .spot').forEach((n) => {
    n.addEventListener('click', () => selectSpot(n.getAttribute('data-spot')));
  });
  selectSpot('zhuozheng');

  // 名园筛选
  document.querySelectorAll('.fbtn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.fbtn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.getAttribute('data-filter');
      document.querySelectorAll('.garden-card').forEach((card) => {
        const era = card.getAttribute('data-era');
        const her = card.getAttribute('data-heritage');
        const show = f === 'all' || (f === 'heritage' && her === '1') || era === f;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>

