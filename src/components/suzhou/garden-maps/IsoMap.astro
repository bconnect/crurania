---
/* 十大园轴测海报 · 分发器：攻略页"手绘导览图"面板按园 id 渲染对应海报 */
import IsoZhuozhengyuan from './IsoZhuozhengyuan.astro';
import IsoLiuyuan from './IsoLiuyuan.astro';
import IsoWangshi from './IsoWangshi.astro';
import IsoHuanxiu from './IsoHuanxiu.astro';
import IsoShizilin from './IsoShizilin.astro';
import IsoCanglangting from './IsoCanglangting.astro';
import IsoYipu from './IsoYipu.astro';
import IsoOuyuan from './IsoOuyuan.astro';
import IsoTuisi from './IsoTuisi.astro';
import IsoYiyuan from './IsoYiyuan.astro';

const { id } = Astro.props;
const maps: Record<string, any> = {
  g1: IsoZhuozhengyuan,
  g2: IsoLiuyuan,
  g3: IsoWangshi,
  g4: IsoHuanxiu,
  g5: IsoShizilin,
  g6: IsoCanglangting,
  g7: IsoYipu,
  g8: IsoOuyuan,
  g9: IsoTuisi,
  g10: IsoYiyuan,
};
const Cmp = maps[id];
---
{Cmp && <Cmp />}
