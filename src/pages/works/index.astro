---
import Base from '../../layouts/Base.astro';
import SectionList from '../../components/SectionList.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('works')).filter((e) => !e.data.draft)
  .sort((a, b) => (b.data.date ?? 0) - (a.data.date ?? 0));
---
<Base title="作 品">
  <SectionList section="works" zh="作 品" en="Works" items={items} />
</Base>
