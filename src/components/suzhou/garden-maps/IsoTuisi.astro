    <path d="M 350,442 Q 392,416 432,440 L 432,446 Q 392,422 350,446 Z" fill="#d9d0ba" stroke="#2c3531" stroke-width="0.7" />
    <path d="M 344,428 Q 392,398 438,426 L 438,436 Q 392,408 344,436 Z" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
    <line x1="362" y1="419" x2="362" y2="434" stroke="#2c3531" stroke-width="0.9" />
    <line x1="376" y1="414" x2="376" y2="429" stroke="#2c3531" stroke-width="0.9" />
    <line x1="392" y1="412" x2="392" y2="427" stroke="#2c3531" stroke-width="0.9" />
    <line x1="408" y1="414" x2="408" y2="429" stroke="#2c3531" stroke-width="0.9" />
    <line x1="422" y1="419" x2="422" y2="434" stroke="#2c3531" stroke-width="0.9" />
  </g>

  <!-- 辛台（东北角两层） -->
  <g>
    <rect x="418" y="368" width="44" height="15" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <rect x="425" y="350" width="30" height="12" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <polygon points="412,370 468,370 472,366 462,356 418,356 408,366" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
    <polygon points="420,350 460,350 454,343 426,343" fill="#67756c" stroke="#333d38" stroke-width="0.7" />
  </g>

  <!-- 菰雨生凉轩（东岸水榭） -->
  <g>
    <rect x="408" y="496" width="54" height="18" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <line x1="419" y1="496" x2="419" y2="514" stroke="#2c3531" stroke-width="0.6" />
    <line x1="432" y1="496" x2="432" y2="514" stroke="#2c3531" stroke-width="0.6" />
    <line x1="445" y1="496" x2="445" y2="514" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="402,498 468,498 472,494 462,484 408,484 398,494" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
