  <path d="M 284,540 l 6,-3 M 292,536 l 6,-2 M 300,535 l 6,1" stroke="#7a7568" stroke-width="0.7" />
  <path d="M 312,554 L 336,570 L 322,588" fill="none" stroke="#2c3531" stroke-width="2" />
  <path d="M 284,556 L 264,574 L 274,594" fill="none" stroke="#2c3531" stroke-width="1.4" opacity="0.85" />

  <!-- 涵碧山房 + 明瑟楼 -->
  <g>
    <rect x="132" y="486" width="90" height="10" fill="#ddd3bc" stroke="#2c3531" stroke-width="0.8" />
    <rect x="140" y="462" width="50" height="24" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <line x1="150" y1="462" x2="150" y2="486" stroke="#2c3531" stroke-width="0.6" />
    <line x1="162" y1="462" x2="162" y2="486" stroke="#2c3531" stroke-width="0.6" />
    <line x1="174" y1="462" x2="174" y2="486" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="132,464 198,464 204,458 192,446 138,446 126,458" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
    <!-- 明瑟楼（两层） -->
    <rect x="196" y="452" width="40" height="16" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <rect x="202" y="436" width="28" height="12" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <polygon points="188,454 244,454 248,450 238,440 194,440 184,450" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    <polygon points="196,438 236,438 240,434 230,424 202,424 192,434" fill="#67756c" stroke="#333d38" stroke-width="0.7" />
  </g>

  <!-- 曲溪楼（临水长廊楼） -->
