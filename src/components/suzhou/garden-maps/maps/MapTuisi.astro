---
/* 退思园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="退思园手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">退思园</text>
  <text x="124" y="44" class="gm-sub">贴水名园 · 退则思过 —— 手绘示意，非实测</text>
  <!-- 西部住宅 -->
  <rect class="gm-yard" x="22" y="120" width="100" height="222"/>
  <g class="gm-bldg"><rect x="40" y="138" width="64" height="22"/><polygon class="gm-roof" points="34,138 110,138 100,129 44,129"/></g>
  <text x="40" y="174" class="gm-label">荫余堂（正厅）</text>
  <g class="gm-bldg"><rect x="42" y="210" width="60" height="40"/><polygon class="gm-roof" points="36,210 108,210 98,200 46,200"/></g>
  <text x="42" y="268" class="gm-label">畹芗楼（走马楼）</text>
  <text x="40" y="284" class="gm-anno">门厅·茶厅·轿厅沿中轴</text>
  <text x="34" y="330" class="gm-label">大门（西）</text>
  <!-- 天桥（连接宅与园） -->
  <path class="gm-bridge" d="M122,190 L148,190"/>
  <text x="112" y="180" class="gm-label">天桥（廊桥）</text>
  <!-- 水池 -->
  <path class="gm-water" d="M170,148 C208,116 300,108 352,134 C396,156 404,210 372,246 C334,288 238,294 190,264 C150,238 140,184 170,148 Z"/>
  <path class="gm-ripple" d="M196,168 q18,-5 36,0 M250,196 q20,-5 40,0 M200,228 q16,-5 32,0 M300,146 q16,-4 32,0"/>
  <text x="252" y="206" class="gm-water-label2">池水贴岸</text>
  <!-- 北岸：退思草堂 -->
  <g class="gm-bldg"><rect x="238" y="84" width="76" height="26"/><polygon class="gm-roof" points="232,84 320,84 308,73 244,73"/></g>
  <text x="232" y="122" class="gm-label-big">退思草堂（主厅）</text>
  <!-- 琴房（东北） -->
  <g class="gm-bldg"><rect x="340" y="92" width="36" height="18"/><polygon class="gm-roof" points="336,92 380,92 373,84 343,84"/></g>
  <text x="342" y="128" class="gm-label">琴房</text>
  <!-- 东北假山与眠云亭 -->
  <path class="gm-rock" d="M372,116 C380,94 410,88 422,106 C430,120 420,136 400,138 C386,139 368,132 372,116 Z"/>
  <g class="gm-pav"><rect x="398" y="70" width="16" height="12"/><polygon class="gm-roof" points="395,70 417,70 411,63 401,63"/></g>
  <text x="346" y="68" class="gm-label">眠云亭（假山顶）</text>
  <!-- 东岸：水香榭 -->
  <g class="gm-bldg"><rect x="398" y="180" width="32" height="16"/><polygon class="gm-roof" points="394,180 434,180 428,172 400,172"/></g>
  <text x="378" y="172" class="gm-label">水香榭</text>
  <!-- 南岸：菰雨生凉轩 -->
  <g class="gm-bldg"><rect x="232" y="262" width="70" height="20"/><polygon class="gm-roof" points="226,262 308,262 298,253 236,253"/></g>
  <text x="230" y="300" class="gm-label">菰雨生凉轩（夏景）</text>
  <!-- 西南：闹红一舸 -->
  <g>
    <polygon class="gm-bldg2" points="152,262 210,262 202,250 160,250"/>
    <polygon class="gm-roof" points="168,250 194,238 202,250"/>
    <text x="146" y="284" class="gm-label">闹红一舸（石舫）</text>
  </g>
  <!-- 东南：岁寒居 -->
  <g class="gm-bldg"><rect x="352" y="248" width="44" height="18"/><polygon class="gm-roof" points="347,248 401,248 393,240 355,240"/></g>
  <text x="350" y="284" class="gm-label">岁寒居（冬景）</text>
  <!-- 九曲回廊（贴水） -->
  <path class="gm-path" d="M152,148 C148,196 152,236 176,262 M214,290 C260,306 330,304 372,282 M396,252 C412,230 412,200 398,180 M376,150 C360,132 336,122 316,120"/>
  <text x="130" y="240" class="gm-anno" transform="rotate(-84 136 244)">九曲回廊（贴水而筑）</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="330" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,320 428,334 424,331 420,334" fill="#A94442"/>
    <text x="420" y="354" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="30" y="60" width="24" height="24" rx="3"/>
    <text x="36" y="77" class="gm-sealtext">退</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-water-label2 { font-size:11px; fill:#5f8579; letter-spacing:3px; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-bldg2 { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
