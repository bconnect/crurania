    <rect x="48" y="560" width="66" height="24" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.1" />
    <line x1="60" y1="560" x2="60" y2="584" stroke="#2c3531" stroke-width="0.6" />
    <line x1="74" y1="560" x2="74" y2="584" stroke="#2c3531" stroke-width="0.6" />
    <line x1="88" y1="560" x2="88" y2="584" stroke="#2c3531" stroke-width="0.6" />
    <line x1="102" y1="560" x2="102" y2="584" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="44,562 118,562 124,556 112,544 50,544 38,556" fill="#4a564f" stroke="#333d38" stroke-width="0.9" />
  </g>
  <g>
    <rect x="48" y="628" width="66" height="24" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.1" />
    <line x1="60" y1="628" x2="60" y2="652" stroke="#2c3531" stroke-width="0.6" />
    <line x1="74" y1="628" x2="74" y2="652" stroke="#2c3531" stroke-width="0.6" />
    <line x1="88" y1="628" x2="88" y2="652" stroke="#2c3531" stroke-width="0.6" />
    <line x1="102" y1="628" x2="102" y2="652" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="44,630 118,630 124,624 112,612 50,612 38,624" fill="#4a564f" stroke="#333d38" stroke-width="0.9" />
  </g>
  <!-- 月洞门 -->
  <circle cx="140" cy="594" r="13" fill="none" stroke="#2c3531" stroke-width="1.5" />

  <!-- 琴房（西北） -->
  <g>
    <rect x="150" y="420" width="46" height="19" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <line x1="161" y1="420" x2="161" y2="439" stroke="#2c3531" stroke-width="0.6" />
    <line x1="176" y1="420" x2="176" y2="439" stroke="#2c3531" stroke-width="0.6" />
    <line x1="189" y1="420" x2="189" y2="439" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="146,422 200,422 204,418 194,408 152,408 142,418" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
  </g>

  <!-- 退思草堂（正北，主厅） -->
  <g>
    <rect x="228" y="382" width="90" height="26" fill="#f7f1e3" stroke="#2c3531" stroke-width="1.2" />
    <line x1="241" y1="382" x2="241" y2="408" stroke="#2c3531" stroke-width="0.6" />
    <line x1="255" y1="382" x2="255" y2="408" stroke="#2c3531" stroke-width="0.6" />
    <line x1="269" y1="382" x2="269" y2="408" stroke="#2c3531" stroke-width="0.6" />
    <line x1="283" y1="382" x2="283" y2="408" stroke="#2c3531" stroke-width="0.6" />
