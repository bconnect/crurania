  <!-- 眠云亭（南阜） -->
  <path d="M 306,690 C 300,668 316,654 338,654 C 360,654 374,670 368,690 C 350,700 322,702 306,690 Z" fill="#b8b3a6" stroke="#8a857a" stroke-width="1" />
  <g>
    <polygon points="318,652 352,652 356,648 346,638 324,638 314,648" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    <rect x="322" y="652" width="26" height="12" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
  </g>

  <!-- 水香榭（南岸） -->
  <g>
    <polygon points="216,656 252,656 256,652 246,642 222,642 212,652" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    <rect x="220" y="656" width="28" height="12" fill="#f7f1e3" stroke="#2c3531" stroke-width="0.9" />
    <line x1="228" y1="668" x2="228" y2="674" stroke="#2c3531" stroke-width="0.7" />
    <line x1="240" y1="668" x2="240" y2="674" stroke="#2c3531" stroke-width="0.7" />
  </g>

  <!-- 三曲桥（南段跨水） -->
  <path d="M 268,646 L 284,632 L 276,618" fill="none" stroke="#2c3531" stroke-width="1.8" />
  <line x1="274" y1="640" x2="278" y2="637" stroke="#2c3531" stroke-width="0.7" />

  <!-- ═══ 林木 ═══ -->
  <RTree x={120} y={470} r={11} tone={2} />
  <RTree x={206} y={380} r={11} tone={0} />
  <RTree x={352} y={368} r={10} tone={1} />
  <RTree x={120} y={690} r={12} tone={1} />
  <RTree x={392} y={688} r={11} tone={2} />
  <RTree x={452} y={620} r={10} tone={0} />
  <RTree x={176} y={700} r={11} tone={3} />

  <!-- ═══ 游线 ═══ -->
