    <ellipse cx="368" cy="756" rx="2.2" ry="3" /><ellipse cx="372" cy="764" rx="2.2" ry="3" />
    <ellipse cx="300" cy="704" rx="2.2" ry="3" /><ellipse cx="304" cy="712" rx="2.2" ry="3" />
