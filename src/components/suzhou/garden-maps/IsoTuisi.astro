    <polygon points="220,384 326,384 334,376 318,362 228,362 212,376" fill="#4a564f" stroke="#333d38" stroke-width="0.9" />
    <polygon points="232,362 314,362 304,354 242,354" fill="#67756c" stroke="#333d38" stroke-width="0.8" />
    <line x1="258" y1="354" x2="288" y2="354" stroke="#333d38" stroke-width="2" />
