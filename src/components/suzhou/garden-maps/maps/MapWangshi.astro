---
/* 网师园 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="网师园手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">网师园</text>
  <text x="106" y="44" class="gm-sub">小园极则 · 月到风来 —— 手绘示意，非实测</text>
  <!-- 住宅（东部） -->
  <rect class="gm-yard" x="330" y="70" width="100" height="252"/>
  <path class="gm-path" d="M380,322 L380,90"/>
  <g class="gm-bldg"><rect x="348" y="120" width="64" height="22"/><polygon class="gm-roof" points="342,120 418,120 408,111 352,111"/></g>
  <text x="344" y="158" class="gm-label">大厅（积善堂）</text>
  <g class="gm-bldg"><rect x="350" y="220" width="60" height="22"/><polygon class="gm-roof" points="344,220 416,220 406,211 354,211"/></g>
  <text x="352" y="258" class="gm-label">内宅（楼厅）</text>
  <text x="352" y="346" class="gm-label">大门（阔家头巷）</text>
  <!-- 彩霞池 -->
  <path class="gm-water" d="M105,150 C140,118 220,112 262,136 C298,156 304,204 278,236 C248,272 168,278 128,250 C94,226 82,176 105,150 Z"/>
  <path class="gm-ripple" d="M130,170 q16,-5 32,0 M170,196 q18,-5 36,0 M140,222 q14,-4 28,0 M215,150 q14,-4 28,0"/>
  <text x="178" y="200" class="gm-water-label">彩霞池</text>
  <!-- 北岸 -->
  <g class="gm-bldg"><rect x="122" y="96" width="52" height="22"/><polygon class="gm-roof" points="116,96 180,96 170,87 126,87"/></g>
  <text x="116" y="82" class="gm-label-big">看松读画轩</text>
  <g class="gm-bldg"><rect x="196" y="100" width="48" height="20"/><polygon class="gm-roof" points="190,100 250,100 242,92 198,92"/></g>
  <text x="212" y="90" class="gm-label">竹外一枝轩</text>
  <g class="gm-bldg"><rect x="86" y="64" width="40" height="20"/><polygon class="gm-roof" points="81,64 131,64 124,56 88,56"/></g>
  <text x="76" y="52" class="gm-label">集虚斋</text>
  <!-- 西岸：月到风来亭 -->
  <g class="gm-pav"><rect x="76" y="182" width="18" height="14"/><polygon class="gm-roof" points="72,182 98,182 92,174 78,174"/></g>
  <text x="30" y="176" class="gm-label-big">月到风来亭</text>
  <!-- 南岸 -->
  <g class="gm-bldg"><rect x="128" y="262" width="56" height="22"/><polygon class="gm-roof" points="122,262 190,262 180,253 132,253"/></g>
  <text x="122" y="300" class="gm-label-big">小山丛桂轩</text>
  <path class="gm-rock" d="M120,312 l12,-20 14,20 z"/>
  <path class="gm-rock" d="M152,316 l9,-15 10,15 z"/>
  <text x="182" y="322" class="gm-label">云冈（黄石假山）</text>
  <!-- 濯缨水阁 -->
  <g class="gm-bldg"><rect x="88" y="228" width="30" height="16"/><polygon class="gm-roof" points="84,228 122,228 116,220 90,220"/></g>
  <text x="36" y="246" class="gm-label">濯缨水阁</text>
  <!-- 引静桥（东南角小桥） -->
  <path class="gm-bridge" d="M252,246 q12,-8 24,-2"/>
  <text x="282" y="252" class="gm-label">引静桥</text>
  <!-- 殿春簃小院（西北） -->
  <rect class="gm-yard" x="30" y="20" width="118" height="88"/>
  <g class="gm-pav"><rect x="52" y="40" width="16" height="12"/><polygon class="gm-roof" points="49,40 71,40 65,33 55,33"/></g>
  <text x="74" y="51" class="gm-label">冷泉亭</text>
  <circle class="gm-well" cx="118" cy="80" r="5"/>
  <text x="96" y="98" class="gm-label">井</text>
  <text x="44" y="24" class="gm-label-big" transform="translate(0,0)">殿春簃（书斋庭院）</text>
  <!-- 园墙分隔 -->
  <line x1="300" y1="70" x2="300" y2="322" stroke="#9c8f74" stroke-width="1" stroke-dasharray="6 3"/>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="262" y="330" width="24" height="24" rx="3"/>
    <text x="268" y="347" class="gm-sealtext">网</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-water-label { font-size:12px; fill:#5f8579; letter-spacing:4px; }
  .gm-yard { fill:#f2ecda; stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; }
  .gm-bridge { fill:none; stroke:#A94442; stroke-width:2; }
  .gm-well { fill:none; stroke:#2c3531; stroke-width:1; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
