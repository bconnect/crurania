---
/* 轴测手绘海报 · 留园（欲扬先抑 · 奇峰冠云） */
import Frame from '../poster/Frame.astro';
import Clouds from '../poster/Clouds.astro';
import Plaque from '../poster/Plaque.astro';
import PanelFrame from '../poster/PanelFrame.astro';
import PSect from '../poster/PSect.astro';
import Divider from '../poster/Divider.astro';
import RouteScroll from '../poster/RouteScroll.astro';
import Compass from '../poster/Compass.astro';
import Disclaimer from '../poster/Disclaimer.astro';
import VTag from '../poster/VTag.astro';
import RTree from '../poster/RTree.astro';
import Rock from '../poster/Rock.astro';
import Lotus from '../poster/Lotus.astro';
import Seal from '../poster/Seal.astro';
---
<svg class="ip" viewBox="0 0 760 920" role="img" aria-label="留园手绘游览图">
  <Frame />
  <Clouds />
  <Plaque title="留园游览图" sub="欲扬先抑 · 奇峰冠云" />

  <!-- ═══ 右侧信息栏 ═══ -->
  <g>
    <PanelFrame />
    <PSect y={158} title="游览特点" />
    <text x="534" y="192" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【欲扬先抑】</text>
    <text x="534" y="210" font-size="12" fill="#2c3531" class="ip-serif">窄巷尽头，豁然开朗</text>
    <text x="534" y="236" font-size="13.5" font-weight="700" fill="#A94442" class="ip-serif">【四区格局】</text>
    <text x="534" y="254" font-size="12" fill="#2c3531" class="ip-serif">山水 · 庭院 · 田园 · 山林</text>

    <Divider y={278} />
    <PSect y={308} title="必打卡景观" />
    <!-- 冠云峰小图（高瘦湖石） -->
    <g transform="translate(540,322)">
      <ellipse cx="10" cy="30" rx="16" ry="9" fill="#b8b3a6" stroke="#8a857a" stroke-width="0.9" />
      <ellipse cx="8" cy="14" rx="11" ry="10" fill="#b8b3a6" stroke="#8a857a" stroke-width="0.9" />
      <ellipse cx="12" cy="0" rx="7" ry="7" fill="#b8b3a6" stroke="#8a857a" stroke-width="0.9" />
      <path d="M 6,12 c 3,-3 7,-2 8,1 M 10,26 c 2,-2 6,-1 6,2" stroke="#7a7568" stroke-width="0.6" fill="none" />
    </g>
    <text x="586" y="342" font-size="13" font-weight="700" fill="#2c3531" class="ip-serif">冠云峰</text>
    <text x="586" y="360" font-size="11" fill="#5c5548" class="ip-serif">江南三大名石之首</text>
    <!-- 五峰仙馆小图 -->
    <g transform="translate(530,384)">
      <rect x="2" y="14" width="46" height="16" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
      <line x1="11" y1="14" x2="11" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="21" y1="14" x2="21" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="31" y1="14" x2="31" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <line x1="40" y1="14" x2="40" y2="30" stroke="#2c3531" stroke-width="0.7" />
      <polygon points="-2,16 52,16 56,12 46,2 4,2 -6,12" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
    </g>
    <text x="586" y="394" font-size="13" font-weight="700" fill="#2c3531" class="ip-serif">五峰仙馆</text>
    <text x="586" y="412" font-size="11" fill="#5c5548" class="ip-serif">江南第一厅 · 楠木</text>

    <Divider y={434} />
    <PSect y={466} title="推荐路线" />
    <RouteScroll y={486} lines={["曲尺入口 → 古木交柯 → 绿荫轩", "→ 涵碧山房 → 闻木樨香轩 → 小蓬莱", "→ 五峰仙馆 → 冠云峰 → 又一村"]} />

    <PSect y={640} title="贴士" />
    <text x="534" y="672" font-size="11.5" fill="#2c3531" class="ip-serif">※ 峰前取景以门框为框，人在画中</text>
    <text x="534" y="692" font-size="11.5" fill="#2c3531" class="ip-serif">※ 深秋枫林，留园最美一季</text>

    <Compass x={668} y={768} />
    <Disclaimer />
  </g>

  <!-- ═══ 主景 ═══ -->

  <!-- 曲尺形入口（窄廊，欲扬先抑） -->
  <g stroke="#2c3531" stroke-width="1.6" fill="none">
    <path d="M 372,760 L 372,830 L 448,830" />
    <path d="M 396,752 L 396,808 L 448,808" stroke-width="0.8" />
  </g>
  <text x="336" y="846" font-size="10.5" fill="#8a7d63" class="ip-serif">曲尺入口 · 欲扬先抑</text>

  <!-- 古木交柯（双树交枝） -->
  <RTree x={352} y={742} r={10} tone={2} />
  <RTree x={368} y={736} r={9} tone={1} />
  <!-- 绿荫轩 -->
  <g>
    <rect x="330" y="694" width="44" height="18" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <line x1="340" y1="694" x2="340" y2="712" stroke="#2c3531" stroke-width="0.6" />
    <line x1="352" y1="694" x2="352" y2="712" stroke="#2c3531" stroke-width="0.6" />
    <line x1="362" y1="694" x2="362" y2="712" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="324,696 380,696 384,692 372,680 332,680 320,692" fill="#4a564f" stroke="#333d38" stroke-width="0.8" />
  </g>

  <!-- 又一村（盆景区） -->
  <g>
    <line x1="272" y1="396" x2="322" y2="396" stroke="#2c3531" stroke-width="1.4" />
    <line x1="276" y1="388" x2="320" y2="388" stroke="#2c3531" stroke-width="0.7" />
    <line x1="284" y1="380" x2="314" y2="380" stroke="#2c3531" stroke-width="0.7" />
    <line x1="282" y1="396" x2="282" y2="380" stroke="#2c3531" stroke-width="0.8" />
    <line x1="298" y1="396" x2="298" y2="380" stroke="#2c3531" stroke-width="0.8" />
    <line x1="312" y1="396" x2="312" y2="380" stroke="#2c3531" stroke-width="0.8" />
    <g stroke="#2c3531" stroke-width="0.6">
      <path d="M 254,404 l 14,0 l -2,8 l -10,0 z" fill="#c98a5a" />
      <circle cx="261" cy="400" r="5" fill="#54763d" />
      <path d="M 330,404 l 14,0 l -2,8 l -10,0 z" fill="#c98a5a" />
      <circle cx="337" cy="400" r="5" fill="#6a914d" />
    </g>
  </g>

  <!-- 闻木樨香轩（小山丛桂） -->
  <path d="M 128,452 C 122,428 140,412 166,412 C 190,412 204,428 198,450 C 178,460 146,462 128,452 Z" fill="#b8b3a6" stroke="#8a857a" stroke-width="1" />
  <g>
    <rect x="146" y="416" width="42" height="16" fill="#f7f1e3" stroke="#2c3531" stroke-width="1" />
    <line x1="156" y1="416" x2="156" y2="432" stroke="#2c3531" stroke-width="0.6" />
    <line x1="166" y1="416" x2="166" y2="432" stroke="#2c3531" stroke-width="0.6" />
    <line x1="176" y1="416" x2="176" y2="432" stroke="#2c3531" stroke-width="0.6" />
    <polygon points="140,418 194,418 198,414 188,404 146,404 136,414" fill="#4a564f" stroke="#333d38" stroke-width="0.7" />
