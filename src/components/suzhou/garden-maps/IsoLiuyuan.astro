    <ellipse cx="226" cy="452" rx="2.2" ry="3" /><ellipse cx="230" cy="460" rx="2.2" ry="3" />
    <ellipse cx="292" cy="556" rx="2.2" ry="3" /><ellipse cx="296" cy="564" rx="2.2" ry="3" />
