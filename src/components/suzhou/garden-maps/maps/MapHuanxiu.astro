---
/* 环秀山庄 · 手绘示意图 */
---
<svg class="gm" viewBox="0 0 460 380" role="img" aria-label="环秀山庄手绘示意图">
  <rect x="7" y="7" width="446" height="366" fill="#faf6ec" stroke="#2c3531" stroke-width="2.4"/>
  <rect x="12" y="12" width="436" height="356" fill="none" stroke="#2c3531" stroke-width="0.7"/>
  <text x="26" y="44" class="gm-title">环秀山庄</text>
  <text x="200" y="44" class="gm-sub">半亩假山甲天下 —— 手绘示意，非实测</text>
  <!-- 园门（东北） -->
  <path class="gm-path" d="M392,62 L340,62"/>
  <text x="394" y="66" class="gm-label">园门</text>
  <!-- 北部主厅 -->
  <g class="gm-bldg"><rect x="180" y="64" width="84" height="26"/><polygon class="gm-roof" points="174,64 270,64 258,53 186,53"/></g>
  <text x="182" y="100" class="gm-label-big">环秀山庄大厅</text>
  <!-- 大假山（东南主体） -->
  <path class="gm-rock" d="M150,242 C136,204 150,158 196,132 C240,108 300,116 322,158 C342,196 330,240 296,262 C252,290 168,286 150,242 Z"/>
  <g class="gm-rockhatch">
    <path d="M186,216 l18,-24 M218,196 l16,-22 M254,184 l14,-18 M288,200 l14,-16 M198,250 l16,-18 M240,238 l16,-16 M274,240 l14,-14 M232,146 l12,-14 M268,142 l12,-12"/>
  </g>
  <!-- 主峰次峰 -->
  <path class="gm-rock" d="M248,132 l14,-30 16,30 z"/>
  <text x="282" y="112" class="gm-label-big">主峰</text>
  <path class="gm-rock" d="M196,154 l10,-20 12,20 z"/>
  <text x="164" y="146" class="gm-label">次峰</text>
  <!-- 山道石室 -->
  <path class="gm-path" d="M170,240 C200,226 216,230 234,210 C252,190 246,170 262,152"/>
  <text x="206" y="222" class="gm-anno">石室·古道（可穿行）</text>
  <!-- 飞雪泉（山南麓） -->
  <path class="gm-ripple2" d="M300,268 q8,10 0,18 M312,268 q8,10 0,18"/>
  <text x="316" y="284" class="gm-label">飞雪泉</text>
  <!-- 西部曲池 -->
  <path class="gm-water" d="M48,222 C70,200 112,196 132,216 C150,234 144,266 118,282 C92,298 56,292 44,268 C34,248 34,238 48,222 Z"/>
  <path class="gm-ripple" d="M62,236 q12,-4 24,0 M78,258 q12,-4 24,0"/>
  <!-- 半潭秋水一房山亭 -->
  <g class="gm-pav"><rect x="96" y="196" width="18" height="13"/><polygon class="gm-roof" points="92,196 118,196 112,189 98,189"/></g>
  <text x="122" y="204" class="gm-label">半潭秋水一房山亭</text>
  <!-- 补秋舫（旱船，西南） -->
  <g>
    <polygon class="gm-bldg2" points="36,296 96,296 88,284 44,284"/>
    <polygon class="gm-roof" points="52,284 80,270 88,284"/>
    <text x="40" y="316" class="gm-label">补秋舫（旱船）</text>
  </g>
  <!-- 山池标注 -->
  <text x="60" y="190" class="gm-anno">曲池（山影倒悬）</text>
  <text x="148" y="300" class="gm-label-big">湖石大假山（清 · 戈裕良叠）</text>
  <text x="148" y="316" class="gm-anno">园不足三亩，山占其半——苏州湖石假山第一</text>
  <!-- 指北针 -->
  <g class="gm-north">
    <circle cx="424" cy="42" r="14" fill="none" stroke="#2c3531" stroke-width="1"/>
    <polygon points="424,32 428,46 424,43 420,46" fill="#A94442"/>
    <text x="420" y="66" class="gm-anno">N</text>
  </g>
  <!-- 印章 -->
  <g>
    <rect class="gm-seal" x="30" y="120" width="24" height="24" rx="3"/>
    <text x="36" y="137" class="gm-sealtext">环</text>
  </g>
</svg>
<style>
  .gm { display:block; width:100%; height:auto; }
  .gm text { font-family: var(--serif); }
  .gm-title { font-size:24px; font-weight:700; fill:#2c3531; letter-spacing:8px; }
  .gm-sub { font-size:11px; fill:#8a7d63; letter-spacing:1px; }
  .gm-water { fill:#b9d0c9; }
  .gm-ripple { fill:none; stroke:#7fa398; stroke-width:.8; opacity:.75; }
  .gm-ripple2 { fill:none; stroke:#7fa398; stroke-width:1.4; }
  .gm-rock { fill:#d8ccb2; stroke:#9c8f74; stroke-width:1; }
  .gm-rockhatch { stroke:#9c8f74; stroke-width:.8; }
  .gm-bldg rect, .gm-pav rect { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-bldg2 { fill:#fdfbf3; stroke:#2c3531; stroke-width:1.1; }
  .gm-roof { fill:#4a564f; }
  .gm-path { fill:none; stroke:#a08c6c; stroke-width:1.1; stroke-dasharray:3 3; }
  .gm-label { font-size:10.5px; fill:#2c3531; }
  .gm-label-big { font-size:12px; font-weight:700; fill:#2c3531; }
  .gm-anno { font-size:9.5px; fill:#8a7d63; }
  .gm-seal { fill:#A94442; }
  .gm-sealtext { fill:#faf6ec; font-size:15px; font-weight:700; }
</style>
